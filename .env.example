# Existing guest-facing AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_POWERFUL=gpt-5.6-sol
# JSON map isolating each client's OpenAI vector store: {"suitesmine":"vs_..."}
OPENAI_VECTOR_STORES_JSON={}
OLIVIA_WEB_SEARCH_ENABLED=true
OLIVIA_MAX_TOOL_ROUNDS=3

# Olivia v2 Python engine
OLIVIA_DEMO_MODE=true
OLIVIA_V2_URL=

# Dashboard AI assistance through Hugging Face
HF_TOKEN=
# Accepted alias if already used in an existing environment
HUGGING_FACE_TOKEN=
HF_DASHBOARD_MODEL=openai/gpt-oss-20b:fastest

# Persistent multi-site conversations
DATABASE_URL=
# Required for local development and Vercel when Railway private DNS is unavailable
DATABASE_PUBLIC_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Gmail OAuth mailbox connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Meta social channels: WhatsApp Cloud API, Facebook Messenger, Instagram Messaging
NEXT_PUBLIC_OLIVIA_BASE_URL=https://olivia-ai.o7digital.com
META_WEBHOOK_VERIFY_TOKEN=
META_DEFAULT_CLIENT_CODE=
# Optional JSON map: {"<phone_number_id_or_page_id_or_instagram_id>":"eliteridemexico"}
META_CHANNEL_CLIENTS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Google Analytics 4 reporting
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Suites Mine Cloudbeds integration
CLOUDBEDS_API_KEY=
CLOUDBEDS_ACCESS_TOKEN=
CLOUDBEDS_PROPERTY_ID=
CLOUDBEDS_API_BASE=https://api.cloudbeds.com/api/v1.2
