# Existing guest-facing AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dashboard AI assistance through Hugging Face
HF_TOKEN=
# Accepted alias if already used in an existing environment
HUGGING_FACE_TOKEN=
HF_DASHBOARD_MODEL=openai/gpt-oss-20b:fastest

# Persistent multi-site conversations
DATABASE_URL=
# Required for local development and Vercel when Railway private DNS is unavailable
DATABASE_PUBLIC_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Gmail OAuth mailbox connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Analytics 4 reporting
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Suites Mine Cloudbeds integration
CLOUDBEDS_API_KEY=
CLOUDBEDS_PROPERTY_ID=
